# ZeroQueue + Hubble - copy this file to .env. Never commit the real .env.
PORT=8000
MOCK_MODE=true
CORS_ORIGINS=http://localhost:8000
DEMO_RESET_SECRET=change-me-to-a-long-random-string
MAX_UPLOAD_MB=15
TESSERACT_CMD=

# Groq wording (only used when MOCK_MODE=false)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Moss retrieval (copy these from portal.usemoss.dev)
MOSS_PROJECT_ID=your_project_id
MOSS_PROJECT_KEY=your_project_key
MOSS_INDEX_NAME=hubble-gift-cards

# Intercom human handoff - placeholders only; put real secrets in .env
INTERCOM_ACCESS_TOKEN=your_rotated_access_token
INTERCOM_WEBHOOK_SECRET=your_webhook_signing_secret
INTERCOM_ADMIN_ID=11610928
INTERCOM_TEAM_ID=11621027
INTERCOM_API_BASE=https://api.intercom.io
STATE_DB_FILE=zeroqueue-state.db
